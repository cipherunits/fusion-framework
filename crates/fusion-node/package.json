{
  "name": "fusion-framework",
  "version": "1.2.6",
  "description": "Class-based HTTP framework for Node.js, powered by a shared Rust core via N-API",
  "keywords": [
    "fusion",
    "fusion-framework",
    "cipherunit",
    "backend",
    "backend-framework",
    "http",
    "http-server",
    "web-framework",
    "rest",
    "api",
    "class-based",
    "routing",
    "middleware",
    "swagger",
    "openapi",
    "nodejs",
    "typescript",
    "python",
    "csharp",
    "cross-platform",
    "multi-language",
    "fma",
    "fusion-module-architecture",
    "rust",
    "napi",
    "jwt",
    "cache",
    "tera",
    "templates"
  ],
  "homepage": "https://fusion.cipherunit.xyz/",
  "bugs": {
    "url": "https://github.com/cipherunits/fusion-framework/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cipherunits/fusion-framework.git",
    "directory": "crates/fusion-node"
  },
  "author": "CipherUnits",
  "authorUrl": "https://cipherunit.xyz",
  "authorEmail": "cipherunit.dev@gmail.com",
  "npmUrl":"https://www.npmjs.com/package/fusion-framework",
  "license": "BSD-3-Clause",
  "type": "commonjs",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "static/swagger-ui/**",
    "*.node"
  ],
  "napi": {
    "name": "fusion-node",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc",
        "aarch64-apple-darwin"
      ]
    }
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build:napi": "napi build --platform --release --js false",
    "build:napi:debug": "napi build --platform --js false",
    "prepublishOnly": "node -e \"const fs=require('fs');const ok=fs.readdirSync('.').some(f=>f.endsWith('.node'));if(!ok){console.error('Missing native .node binaries before publish');process.exit(1)}\"",
    "build": "fusion command build",
    "build:dev": "fusion command build:dev",
    "build:stage": "fusion command build:stage",
    "build:prod": "fusion command build:prod",
    "start": "fusion command start",
    "start:dev": "fusion command start:dev",
    "start:stage": "fusion command start:stage",
    "start:prod": "fusion command start:prod",
    "run": "fusion command run",
    "run:dev": "fusion command run:dev",
    "run:stage": "fusion command run:stage",
    "run:prod": "fusion command run:prod",
    "health": "fusion command health",
    "clean": "fusion command clean",
    "install:deps": "fusion command install"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "linux",
    "darwin",
    "win32",
    "macOS"
  ],
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4"
  }
}
